# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU - OMNISTUDY (VITE + REACT + TYPESCRIPT)
# Sao chép tệp này thành .env.local trước khi chạy ứng dụng cục bộ.
# Tuyệt đối không commit .env hoặc .env.local lên kho lưu trữ Git.
# ==============================================================================

# Client ID của ứng dụng Web từ Google Cloud Console (APIs & Services -> Credentials)
# Dùng cho đăng nhập Google OAuth 2.0 (@react-oauth/google) và Google Calendar API v3
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
